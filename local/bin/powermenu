#!/usr/bin/env bash
# Power menu (wlogout), sized to whichever monitor is focused.
#
# Bound to SUPER + M. Pressing it again while the menu is up dismisses it, so
# the bind toggles instead of stacking a second instance on top of the first.
#
# Buttons:  ~/.config/wlogout/layout
# Styling:  ~/.config/matugen/templates/wlogout.css  (generated by `wallpaper`
#           into ~/.config/wlogout/style.css -- never edit that copy)
#
# Three things to know before editing the layout file, all of them because
# wlogout parses JSON with the minimal jsmn library:
#   * comments abort the parse with "Invalid JSON Data" -- keep it pure JSON,
#     which is why the notes live here and not in the file itself
#   * escapes are not decoded, so "\n" arrives on the button as literal \n
#   * the "height"/"width" keys are broken upstream (main.c assigns the first
#     character of the value to a float, so 0.5 becomes 48.0) -- leave them
#     out and take the defaults, which put the caption at 90% height with the
#     icon above it
set -euo pipefail

# `pkill` returns non-zero when nothing matched, which is the "not open yet"
# case -- fall through and open it.
pkill -x wlogout && exit 0

# wlogout takes its margins in pixels, so they have to be derived from the
# monitor or the menu is the wrong size on anything but a 1440p screen.
# hyprctl reports the physical resolution; layer-shell works in logical
# pixels, hence the divide by scale.
read -r id cols rows < <(hyprctl -j monitors | python3 -c '
import json, sys

mons = json.load(sys.stdin)
mon = next((m for m in mons if m["focused"]), mons[0])
w = mon["width"] / mon["scale"]
h = mon["height"] / mon["scale"]
# 15% off each side and 34% off top and bottom leaves a row of five buttons
# that is a little wider than tall -- roughly square once the gaps are in.
print(mon["id"], round(w * 0.15), round(h * 0.34))
')

exec wlogout \
    --buttons-per-row 5 \
    --column-spacing 14 \
    --row-spacing 14 \
    --margin-left "$cols" --margin-right "$cols" \
    --margin-top "$rows" --margin-bottom "$rows" \
    --protocol layer-shell \
    --no-span --primary-monitor "$id"
