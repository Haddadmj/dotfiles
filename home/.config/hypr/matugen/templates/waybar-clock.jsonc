// Generated by matugen from ~/.config/hypr/matugen/templates/waybar-clock.jsonc. Do not edit.
{
    "clock": {
        "format": "󰃭 {:%Y-%m-%d   󰅐 %I:%M %p}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='{{colors.primary.default.hex}}'><b>{}</b></span>",
                "weekdays": "<span color='{{colors.on_surface_variant.default.hex}}'><b>{}</b></span>",
                "days":     "<span color='{{colors.on_surface.default.hex}}'>{}</span>",
                "today":    "<span color='{{colors.on_primary.default.hex}}' background='{{colors.primary.default.hex}}'><b> {} </b></span>"
            }
        },
        "on-click": "pkill -f 'zenity --calendar' || zenity --calendar --title=Calendar --text= --date-format=%Y-%m-%d >/dev/null",
        "actions": { "on-click-right": "mode", "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" }
    }
}
