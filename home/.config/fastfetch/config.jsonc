{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "cyan" },
    "size": { "binaryPrefix": "iec", "ndigits": 1 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}@{host-name-colored}" },
    "separator",

    { "type": "os",       "key": " OS      " },
    { "type": "kernel",   "key": " Kernel  " },
    { "type": "host",     "key": "󰌢 Host    " },
    { "type": "uptime",   "key": "󰅐 Uptime  " },
    { "type": "command",  "key": "󰃭 OS Age  ", "text": "b=$(stat -c %W /); echo \"$(( ($(date +%s) - b) / 86400 )) days (since $(date -d @$b +%F))\"" },
    { "type": "packages", "key": "󰏖 Packages" },
    { "type": "shell",    "key": " Shell   " },
    "break",

    { "type": "de",           "key": " DE      " },
    { "type": "wm",           "key": " WM      " },
    { "type": "display",      "key": "󰍹 Display ", "compactType": "original-with-refresh-rate" },
    { "type": "theme",        "key": "󰉼 Theme   " },
    { "type": "icons",        "key": " Icons   " },
    { "type": "terminal",     "key": " Terminal" },
    { "type": "terminalfont", "key": " Font    " },
    "break",

    { "type": "cpu",    "key": " CPU     ", "temp": true },
    { "type": "gpu",    "key": "󰢮 GPU     ", "temp": true },
    { "type": "memory", "key": " Memory  " },
    { "type": "swap",   "key": "󰓡 Swap    " },
    { "type": "disk",   "key": "󰋊 Disk    ", "folders": "/" },
    { "type": "localip","key": "󰩟 Local IP", "showIpv6": false },
    { "type": "battery","key": " Battery " },
    "break",

    { "type": "colors", "symbol": "circle" }
  ]
}
