// Waybar · floating islands · colors from matugen (colors.css)
// Workspaces: 1 shell (kitty) · 2 web (brave) · 3 code (vscode) · 4 chat · 5 media
// clock lives in clock.jsonc (generated by matugen so the calendar follows the theme)
// needs waybar-git (> 0.15.0) for workspace clicks on Lua-config Hyprland (Waybar#5008)
{
    "include": [
        "~/.config/waybar/clock.jsonc"
    ],
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 8,
    "margin-left": 20,
    "margin-right": 20,
    "spacing": 0,
    "reload_style_on_change": true,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "group/tray-drawer",
        "group/system",
        "custom/language",
        "pulseaudio",
        "clock",
        "custom/power"
    ],
    "custom/launcher": {
        "format": "󰀻",
        "tooltip-format": "Apps  ·  right-click: wofi",
        "on-click": "pkill -x nwg-menu || nwg-menu -va top -ha left -mt 6 -ml 20 -k -isl 36 -iss 18 -padding 4 -term kitty -fm dolphin -cmd-lock hyprlock -cmd-logout 'hyprshutdown || hyprctl dispatch hl.dsp.exit()' -cmd-restart 'systemctl reboot' -cmd-shutdown 'systemctl poweroff'",
        "on-click-right": "pkill wofi || wofi --show drun --allow-images"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "persistent-workspaces": {
            "*": [
                1,
                2,
                3,
                4,
                5
            ]
        },
        "format-icons": {
            "1": "",
            "2": "<span font_family='Font Awesome 7 Brands'></span>",
            "3": "󰨞",
            "4": "",
            "5": "󰝚",
            "default": "󰝥",
            "urgent": "󰀦"
        }
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 100,
        "separate-outputs": true,
        "icon": true,
        "icon-size": 16,
        "rewrite": {
            "": "Desktop",
            "(.*) — Mozilla Firefox": "$1",
            "(.*) - Brave(.*)": "$1",
            "(.*) - Visual Studio Code": "$1"
        }
    },
    "group/tray-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 400,
            "children-class": "tray-child",
            "transition-left-to-right": false,
            "click-to-reveal": false
        },
        "modules": [
            "custom/tray-handle",
            "tray"
        ]
    },
    "custom/tray-handle": {
        "format": "󰅁",
        "tooltip-format": "Tray apps"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10,
        "show-passive-items": true
    },
    "group/system": {
        "orientation": "horizontal",
        "modules": [
            "network",
            "bluetooth",
            "custom/notifications"
        ]
    },
    "network": {
        "format-wifi": "{icon}",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "format-linked": "󰈀",
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}\n󰁅 {bandwidthDownBytes}  󰁝 {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}\n󰁅 {bandwidthDownBytes}  󰁝 {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Offline",
        "interval": 5,
        "on-click": "nm-connection-editor"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "rfkill toggle bluetooth"
    },
    "custom/notifications": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚<sup>●</sup>",
            "none": "󰂚",
            "dnd-notification": "󰂛<sup>●</sup>",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec": "swaync-client -swb",
        "escape": true,
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw"
    },
    "custom/language": {
        "exec": "~/.config/waybar/scripts/kb-layout.py",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "hyprctl switchxkblayout current next"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%  {format_source}",
        "format-muted": "󰝟 muted  {format_source}",
        "format-bluetooth": "{icon}󰂯 {volume}%  {format_source}",
        "format-source": "󰍬",
        "format-source-muted": "󰍭",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "scroll-step": 5,
        "max-volume": 150,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "tooltip-format": "{desc}\nleft: mixer · right: mute · middle: mic"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power menu",
        "menu": "on-click",
        "menu-file": "__HOME__/.config/waybar/power_menu.xml",
        "menu-actions": {
            "lock": "hyprlock",
            "logout": "command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'",
            "suspend": "systemctl suspend",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    }
}
