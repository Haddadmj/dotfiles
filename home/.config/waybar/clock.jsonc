// Generated by matugen from ~/.config/hypr/matugen/templates/waybar-clock.jsonc. Do not edit.
{
    "clock": {
        "format": "󰃭 {:%Y-%m-%d   󰅐 %I:%M %p}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#95cdf7'><b>{}</b></span>",
                "weekdays": "<span color='#c1c7ce'><b>{}</b></span>",
                "days":     "<span color='#e0e3e8'>{}</span>",
                "today":    "<span color='#00344e' background='#95cdf7'><b> {} </b></span>"
            }
        },
        "on-click": "pkill -f 'zenity --calendar' || zenity --calendar --title=Calendar --text= --date-format=%Y-%m-%d >/dev/null",
        "actions": { "on-click-right": "mode", "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" }
    }
}
