{
    "label"   : "lock",
    "action"  : "hyprlock",
    "text"    : "Lock",
    "keybind" : "l"
}
{
    "label"   : "suspend",
    "action"  : "hyprlock & sleep 0.3 ; systemctl suspend",
    "text"    : "Suspend",
    "keybind" : "u"
}
{
    "label"   : "logout",
    "action"  : "hyprctl dispatch 'hl.dsp.exit()'",
    "text"    : "Log out",
    "keybind" : "e"
}
{
    "label"   : "reboot",
    "action"  : "systemctl reboot",
    "text"    : "Reboot",
    "keybind" : "r"
}
{
    "label"   : "shutdown",
    "action"  : "systemctl poweroff",
    "text"    : "Shut down",
    "keybind" : "s"
}
