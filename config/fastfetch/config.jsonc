{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto"
  },
  "display": {
    "separator": ": "
  },
  "modules": [
    "title",
    "separator",
    "os",
    {
          "type": "command",
          "key": "OS Age",
          "text": "echo \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days\""
        },
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    {
      "type": "lm",
      "key": "LM"
    },
    "wm",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    {
      "type": "cpu",
      "temp": true
    },
    "cpuusage",
    {
      "type": "gpu",
      "temp": true
    },
    "memory",
    "swap",
    "disk",
    "btrfs",
    "localip",
    "datetime",
    "locale"
  ]
}
